# ==============================================================================
# ISRO SIH26170: Burn-In Anomaly Detection System Configuration (Template)
# ==============================================================================

APP_ENV=development
DEBUG=True
SECRET_KEY=replace_with_secure_random_key_in_production

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=burnin_user
POSTGRES_PASSWORD=burnin_secure_pass_2026
POSTGRES_DB=burn_in_db

DATABASE_URL=postgresql+psycopg2://burnin_user:burnin_secure_pass_2026@localhost:5433/burn_in_db
ASYNC_DATABASE_URL=postgresql+asyncpg://burnin_user:burnin_secure_pass_2026@localhost:5433/burn_in_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Synthetic Data Engine
DEFAULT_NUM_LOTS=10
DEFAULT_COMPONENTS_PER_LOT=100
SYNTHETIC_RANDOM_SEED=42
